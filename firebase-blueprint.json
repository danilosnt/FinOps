{
  "entities": {
    "Assessment": {
      "title": "Assessment",
      "description": "TI Maturity Assessment for a company",
      "type": "object",
      "properties": {
        "company": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "sector": { "type": "string" },
            "size": { "type": "string" }
          },
          "required": ["name", "sector", "size"]
        },
        "answers": {
          "type": "object",
          "description": "Map of question IDs to scores (1-5)"
        },
        "scores": {
          "type": "object",
          "properties": {
            "overall": { "type": "number" },
            "segmented": { "type": "object" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["company", "answers", "scores", "createdAt"]
    }
  },
  "firestore": {
    "assessments": {
      "schema": "Assessment",
      "description": "Collection of TI maturity assessments"
    }
  }
}
