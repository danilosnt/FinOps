rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: assessments
    // Fields:
    //   - company: object { name, sector, size }
    //   - answers: map { questionId: number }
    //   - scores: object { overall, segmented }
    //   - createdAt: timestamp
    // ===============================================================

    function isValidAssessment(data) {
      return data.keys().hasAll(['company', 'answers', 'scores', 'createdAt']) &&
             data.company.keys().hasAll(['name', 'sector', 'size']) &&
             data.company.name is string && data.company.name.size() > 0 && data.company.name.size() < 100 &&
             data.company.sector is string &&
             data.company.size is string &&
             data.answers is map &&
             data.scores.overall is number &&
             data.scores.segmented is map;
    }

    match /assessments/{assessmentId} {
      // Public access as requested (no authentication)
      allow read: if true;
      allow create: if isValidAssessment(request.resource.data);
      allow update, delete: if false;
    }
  }
}
